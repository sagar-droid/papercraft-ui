{
  "name": "papercraft-ui",
  "version": "0.1.2",
  "description": "A tactile, stationery-inspired component system for React + Tailwind CSS v4. Copy the source (shadcn-style) or import compiled modules.",
  "type": "module",
  "license": "MIT",
  "author": "sagar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagar-droid/papercraft-ui.git"
  },
  "homepage": "https://github.com/sagar-droid/papercraft-ui#readme",
  "bugs": {
    "url": "https://github.com/sagar-droid/papercraft-ui/issues"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "components",
    "ui",
    "paper",
    "shadcn",
    "design-system"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "papercraft-ui": "cli/index.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/papercraft.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cli",
    "src",
    "registry.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "playground:build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vite": "^8.3.1"
  }
}
